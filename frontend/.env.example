# Address of the API gateway as seen from the device running the app.
#   Android emulator -> http://10.0.2.2:8080      (default on Android)
#   iOS simulator    -> http://localhost:8080     (default on iOS)
#   Physical phone   -> http://<your PC's LAN IP>:8080   (phone and PC on the same Wi-Fi)
# You can also change it at runtime from the "Server" link on the login screen.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
